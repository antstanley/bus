                "text": "sink"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/store-s3/src/index.ts"
                },
                "region": {
                  "endLine": 149,
                  "startLine": 142
                }
              }
            }
          ],
          "message": {
            "text": "Infinite loop on a hostile S3 endpoint: S3Store.list loops while keys.length < requested and only breaks on `!page.isTruncated` or (in the no-continuation-token branch) a non-advancing page; an untrusted S3-compatible endpoint that always returns isTruncated:true with a continuationToken and zero matching keys never satisfies either break, so every hooks/MCP list (and therefore every board read/sync) hangs forever."
          },
          "partialFingerprints": {
            "primaryLocationLineHash": "c0177e2be13b4c59:1",
            "security/v1": "security/v1:sha256:0f2b2acf1663a4ff79bcc70dce1054f39ab81b6fc12368ea0fc6ce5bbae913d7"
          },
