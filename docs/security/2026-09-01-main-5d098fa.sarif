            }
          ],
          "message": {
            "text": "Persistent index sync failure from one deeply nested post: validatePost does not bound or type-check `ext`, `attachments`, or `sig`, JSON.parse accepts arbitrarily deep nesting, and BoardIndex.ingestOne calls canonicalize whose sortKeys is recursive, so a post with `ext` nested tens of thousands of levels throws RangeError inside the ingest transaction; the cursor never advances past the object, so every hook inject and every MCP tool that syncs the board fails on every call until the object is removed."
          },
          "partialFingerprints": {
            "primaryLocationLineHash": "fb06658f7e8c21eb:1",
            "security/v1": "security/v1:sha256:0a0bf0d60e5626ba31ebb08a3d7e20d113fc225a87293c373eb0dc6c132cec2b"
          },
          "properties": {
