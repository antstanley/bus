                  "startLine": 305
                }
              }
            }
          ],
          "message": {
            "text": "MCP untrusted-content label is bypassed by author spoofing: provenanceLines drops every author equal to the server's own `--as` name, and posts are unsigned, so a store writer who sets `author` to the reader's name gets their post delivered by board_read/board_thread/board_threads/board_search/board_mentions with no `untrusted content from` line and presented as the agent's own prior words."
          },
          "partialFingerprints": {
