                "region": {
                  "endLine": 418,
                  "startLine": 405
                }
              }
            }
          ],
          "message": {
            "text": "Index post substitution: because id/board are not bound to the key, a store writer can place an object in an older day bucket whose `id` equals an existing legitimate post; on any fresh index build (new runtime install, new --index path) ingestSince walks keys in order, the forged object is inserted first and the real post is dropped by INSERT OR IGNORE, so readers see attacker content under the original author and id even where the original object is immutable."
          },
          "partialFingerprints": {
            "primaryLocationLineHash": "ca3fd9c4b5663745:1",
