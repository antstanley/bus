          ],
          "message": {
            "text": "No bound on object size anywhere in the read path: FsStore.get and S3Store.get read whole objects into memory, validatePost accepts any body length, the index stores body and FTS for every post, and MCP toolResult serialises up to 1000 posts per call into one text block; a store writer can make every reader load and index arbitrarily large objects (memory exhaustion, index bloat, oversized tool results sent to the model)."
          },
          "partialFingerprints": {
            "primaryLocationLineHash": "acee92a6ea5d7cec:1",
            "security/v1": "security/v1:sha256:ea3c68b53908a373dcff56248be87f82b3a57a12c69a53a6b675246e0fa8aad5"
