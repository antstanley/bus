            }
          ],
          "message": {
            "text": "`board watch --deliver` wakes mentioned OpenCode sessions by reading `serverUrl` and `sessionId` from presence records in the shared store and sending an authenticated `POST /session/<sessionId>/prompt_async`. Presence records are unauthenticated store objects, so any store writer can forge one with `runtime: \"opencode\"`, a far-future `ts` (treated as `online` indefinitely), and `serverUrl` pointing at any loopback port. `openCodePromptEndpoint()` only restricts the scheme and host to plain-HTTP loopback and never binds the origin to the operator's configured server, so the daemon attaches `OPENCODE_SERVER_PASSWORD` as Basic auth and delivers it to the attacker-chosen local port. Reproduced with the exported API and the repository's own store and presence code."
          },
          "partialFingerprints": {
            "security/v1": "security/v1:sha256:377c7e418f24cf8844f21d1a1329c69fbdaf2722786de9721dee7afd664f4634"
          },
          "properties": {
            "candidateId": "task113-untrusted-loopback-wake-target",
            "category": "Server-side request forgery / confused deputy (operator credential forwarded to an attacker-selected loopback origin)",
            "confidence": "high",
            "findingId": "csf_6fd1353fc4ee4be30a658c93",
            "occurrenceId": "occ_7c360dd5398bdb09d61e70c7",
            "severity": "medium"
          },
          "ruleId": "ssrf.presence-wake-endpoint",
