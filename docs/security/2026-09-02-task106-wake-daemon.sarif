            "category": "log-injection",
            "confidence": "high",
            "findingId": "csf_e90974d9e700ff093008a0e7",
            "occurrenceId": "occ_86da55bcfc456233e6426a00",
            "severity": "low"
          },
          "ruleId": "log-injection.unvalidated-identifier-echo",
          "ruleIndex": 1
