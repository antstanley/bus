              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/core/src/post.ts"
                },
                "region": {
                  "endLine": 136,
                  "startLine": 133
                }
              }
            }
          ],
          "message": {
            "text": "A post object written directly to the untrusted store can carry mention strings of arbitrary shape and length: the read-side validator checks only that mentions is a string array. When a watch --deliver process observes such a post, the final no-presence-record report interpolates the raw string into a timestamped delivery log line, so attacker-chosen newlines and control bytes break the one-event-per-line invariant of the operator's delivery log and can fabricate apparent delivery outcomes. Delivery decisions and wake-message content are unaffected: the wake message uses only presence-path-validated names and the post id."
          },
          "partialFingerprints": {
            "primaryLocationLineHash": "4aeacc89e06ec3e6:1",
            "security/v1": "security/v1:sha256:afc8787c9af178244fc372d2057ef0d20da56ceb3d781a18cdd359a6957b7364"
          },
          "properties": {
