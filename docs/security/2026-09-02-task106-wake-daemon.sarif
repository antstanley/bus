            "findingId": "csf_3dd1b65ce786e8cf815647e2",
            "occurrenceId": "occ_fa87fbcd263f7ec24b408dd6",
            "severity": "low"
          },
          "ruleId": "availability.silent-wedge-on-bookkeeping-failure",
          "ruleIndex": 0
        }
